#!/usr/bin/env node

const readline = require('readline');
const fs = require('fs');
const path = require('path');
const os = require('os');

const configDir = path.join(os.homedir(), '.mobilism');
const envFile = path.join(configDir, '.env');

async function getUserInput(prompt) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  return new Promise(resolve => {
    rl.question(prompt, answer => {
      rl.close();
      resolve(answer);
    });
  });
}

async function setup() {
  console.log('Mobilism Search Setup\n');

  // Create config directory if it doesn't exist
  if (!fs.existsSync(configDir)) {
    fs.mkdirSync(configDir, { recursive: true });
  }

  const username = await getUserInput('Enter your Mobilism username: ');
  const password = await getUserInput('Enter your Mobilism password: ');

  const envContent = `MOBILISM_USERNAME=${username}\nMOBILISM_PASSWORD=${password}`;
  fs.writeFileSync(envFile, envContent);

  console.log('\nSetup complete! Configuration saved to:', envFile);
}

setup();
